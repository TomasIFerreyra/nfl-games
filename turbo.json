{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "API_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NODE_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
